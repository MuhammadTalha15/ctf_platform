<%- include('../partials/header') %>
<%- include('../partials/admin-shell') %>

      <div class="page-header">
        <div class="breadcrumb">Admin <span>›</span> Dashboard</div>
        <div class="page-title">Welcome back, <%= user.username %></div>
        <div class="page-subtitle">Here's what's happening with your platform today.</div>
      </div>

      <div class="stats-grid">
        <div class="stat-card red">
          <div class="stat-top">
            <div class="stat-icon red">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <span class="stat-delta up">Active</span>
          </div>
          <div class="stat-label">Total Users</div>
          <div class="stat-value" id="cnt-users">0</div>
          <div class="stat-sub"><%= stats.totalPoints || 0 %> total points</div>
        </div>
        <div class="stat-card cyan">
          <div class="stat-top">
            <div class="stat-icon cyan">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12l4 6-10 13L2 9z"/></svg>
            </div>
            <span class="stat-delta up"><%= stats.enabledChallenges %> active</span>
          </div>
          <div class="stat-label">Challenges</div>
          <div class="stat-value" id="cnt-challenges">0</div>
          <div class="stat-sub"><%= stats.enabledChallenges %> published, <%= stats.totalChallenges - stats.enabledChallenges %> drafts</div>
        </div>
        <div class="stat-card orange">
          <div class="stat-top">
            <div class="stat-icon orange">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <span class="stat-delta up"><%= stats.correctSubmissions %> correct</span>
          </div>
          <div class="stat-label">Submissions</div>
          <div class="stat-value" id="cnt-submissions">0</div>
          <div class="stat-sub"><%= stats.totalSubmissions > 0 ? Math.round((stats.correctSubmissions / stats.totalSubmissions) * 100) + '% solve rate' : 'No submissions' %></div>
        </div>
        <div class="stat-card purple">
          <div class="stat-top">
            <div class="stat-icon purple">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <span class="stat-delta up">Running</span>
          </div>
          <div class="stat-label">Platform Health</div>
          <div class="stat-value" style="font-size:20px">All Good</div>
          <div class="stat-sub" style="color:var(--green)">✓ All systems operational</div>
        </div>
      </div>

      <div class="grid-2-eq" style="margin-bottom:20px">
        <div class="card">
          <div class="card-header"><span class="card-title">Recent Activity</span><span class="card-action" onclick="showAddActivity()">+ Add Activity</span></div>
          <div class="timeline">
            <% if (!activities || activities.length === 0) { %>
            <div class="empty">No activities yet. Click "+ Add Activity" to create one.</div>
            <% } else { %>
            <% activities.slice().reverse().forEach(a => { %>
            <div class="tl-item" id="act-<%= a.id %>">
              <div class="tl-dot-wrap"><div class="tl-dot low"></div></div>
              <div class="tl-content">
                <div class="tl-title"><%= a.text %></div>
                <div class="tl-meta">
                  <span class="tl-time"><%= new Date(a.time).toLocaleString() %></span>
                  <span style="margin-left:10px">
                    <a href="javascript:void(0)" onclick='showEditActivity("<%= a.id %>",`<%= a.text.replace(/`/g,'\\`').replace(/\$/g,'\\$') %>`)' style="color:var(--cyan);font-size:10px;margin-right:8px">edit</a>
                    <a href="javascript:void(0)" onclick="showDeleteActivity('<%= a.id %>')" style="color:var(--accent);font-size:10px">delete</a>
                  </span>
                </div>
              </div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">Category Progress</span>
          </div>
          <div style="padding:16px 18px">
            <% if (Object.keys(categoryStats).length === 0) { %>
            <div class="empty">No categories</div>
            <% } else { %>
            <% Object.keys(categoryStats).forEach(cat => { %>
            <% const pct = categoryStats[cat].total > 0 ? Math.min(100, Math.round((categoryStats[cat].solves / Math.max(1, categoryStats[cat].total * 10)) * 100)) : 0 %>
            <div style="margin-bottom:12px">
              <div class="progress-label"><span><%= cat %></span><span><%= categoryStats[cat].solves %> solves · <%= categoryStats[cat].total %> challenges</span></div>
              <div class="progress-bar"><div class="progress-fill" style="width:<%= pct %>%"></div></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </div>
      </div>

      <div class="grid-2">
        <div class="card">
          <div class="card-header">
            <span class="card-title">Platform Overview</span>
            <div style="display:flex;gap:6px">
              <span class="chart-tab active">7D</span>
              <span class="chart-tab">30D</span>
              <span class="chart-tab">90D</span>
            </div>
          </div>
          <div class="chart-legend">
            <div class="legend-item"><div class="legend-dot" style="background:var(--accent)"></div>New Users</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--cyan)"></div>Solves</div>
            <div class="legend-item"><div class="legend-dot" style="background:var(--orange)"></div>Submissions</div>
          </div>
          <div class="chart-wrap" style="padding-top:0">
            <canvas id="overviewChart"></canvas>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title">Recent Submissions</span>
            <a href="/admin/submissions" class="card-action">View all →</a>
          </div>
          <div class="incident-list">
            <% if (recentSubs.length === 0) { %>
            <div class="empty">No submissions yet</div>
            <% } else { %>
            <% recentSubs.forEach(s => { %>
            <div class="incident-row">
              <div class="inc-severity <%= s.correct ? 'low' : 'high' %>"></div>
              <div class="inc-info"><div class="inc-name"><%= s.username %> → <%= s.challengeTitle %></div><div class="inc-target">Flag: <%= (s.flag || '').substring(0, 30) %><%= (s.flag || '').length > 30 ? '...' : '' %></div></div>
              <span class="inc-badge <%= s.correct ? 'low' : 'high' %>"><%= s.correct ? 'CORRECT' : 'WRONG' %></span>
              <div class="inc-time"><%= new Date(s.timestamp).toLocaleString() %></div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </div>
      </div>

      <div class="grid-2-eq" style="margin-bottom:20px">
        <div class="card">
          <div class="card-header">
            <span class="card-title">Active Users</span>
            <a href="/admin/users" class="card-action">View all →</a>
          </div>
          <div class="user-list">
            <% if (recentUsers.length === 0) { %>
            <div class="empty">No users yet</div>
            <% } else { %>
            <% recentUsers.forEach(u => { %>
            <div class="user-row">
              <div class="user-av"><%= (u.username || '?').charAt(0).toUpperCase() %></div>
              <div class="u-info"><div class="u-name"><%= u.username %></div><div class="u-role"><%= u.points || 0 %> pts · <%= (u.solvedChallenges || []).length %> solves</div></div>
              <span class="u-status online">● Online</span>
            </div>
            <% }); %>
            <% } %>
          </div>
        </div>

      </div>

      <div class="sys-grid">
        <div class="sys-item">
          <div class="sys-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="2" x2="9" y2="4"/><line x1="15" y1="2" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="22"/><line x1="15" y1="20" x2="15" y2="22"/><line x1="20" y1="9" x2="22" y2="9"/><line x1="20" y1="14" x2="22" y2="14"/><line x1="2" y1="9" x2="4" y2="9"/><line x1="2" y1="14" x2="4" y2="14"/></svg> CPU Usage</div>
          <div class="sys-val">23%</div>
          <div class="sys-bar"><div class="sys-fill" style="width:23%;background:var(--green)"></div></div>
        </div>
        <div class="sys-item">
          <div class="sys-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg> Memory</div>
          <div class="sys-val">46%</div>
          <div class="sys-bar"><div class="sys-fill" style="width:46%;background:var(--cyan)"></div></div>
        </div>
        <div class="sys-item">
          <div class="sys-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg> Disk Usage</div>
          <div class="sys-val">35%</div>
          <div class="sys-bar"><div class="sys-fill" style="width:35%;background:var(--orange)"></div></div>
        </div>
        <div class="sys-item">
          <div class="sys-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg> Network</div>
          <div class="sys-val">18%</div>
          <div class="sys-bar"><div class="sys-fill" style="width:18%;background:var(--purple)"></div></div>
        </div>
        <div class="sys-item" style="display:flex;flex-direction:column;justify-content:center;align-items:center">
          <div class="sys-label" style="justify-content:center">System Status</div>
          <div class="sys-ok">✓ All Systems Operational</div>
          <div style="font-size:10px;color:var(--text-muted);margin-top:6px">Last checked: 1 min ago</div>
        </div>
      </div>

<style>
.modal-overlay{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:8px;width:92vw}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--border);font-size:13px;font-weight:600;color:var(--text)}
.modal-close{background:none;border:none;color:var(--text-dim);cursor:pointer;padding:4px;line-height:1;font-size:18px}
.modal-close:hover{color:var(--text)}
.modal-body{padding:18px}
</style>

<div id="actModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeActModal()">
  <div class="modal" style="max-width:480px">
    <div class="modal-header"><span id="actModalTitle">Add Activity</span><span class="modal-close" onclick="closeActModal()">&times;</span></div>
    <div class="modal-body" style="padding:18px">
      <input type="hidden" id="actId" value="">
      <label style="font-size:11px;color:var(--text-muted);display:block;margin-bottom:6px">Activity Text</label>
      <textarea id="actText" rows="3" style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:10px;color:var(--text);font-size:12px;resize:vertical;font-family:inherit" placeholder="e.g. Welcome to the CTF! New challenges added."></textarea>
      <div style="margin-top:14px;display:flex;gap:8px;justify-content:flex-end">
        <button class="btn btn-muted" onclick="closeActModal()">Cancel</button>
        <button class="btn btn-accent" onclick="saveActivity()">Save</button>
      </div>
    </div>
  </div>
</div>

<div id="actDelModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeActDelModal()">
  <div class="modal" style="max-width:400px">
    <div class="modal-header"><span>Delete Activity</span><span class="modal-close" onclick="closeActDelModal()">&times;</span></div>
    <div class="modal-body" style="padding:18px;text-align:center">
      <p style="font-size:12px;color:var(--text-muted);margin-bottom:16px">Are you sure you want to delete this activity?</p>
      <div style="display:flex;gap:8px;justify-content:center">
        <button class="btn btn-muted" onclick="closeActDelModal()">Cancel</button>
        <button class="btn btn-accent" onclick="confirmDeleteActivity()" style="background:var(--accent)">Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
var actDeleteId = null;

function showAddActivity() {
  document.getElementById('actId').value = '';
  document.getElementById('actText').value = '';
  document.getElementById('actModalTitle').textContent = 'Add Activity';
  document.getElementById('actModal').style.display = 'flex';
}

function showEditActivity(id, text) {
  document.getElementById('actId').value = id;
  document.getElementById('actText').value = text;
  document.getElementById('actModalTitle').textContent = 'Edit Activity';
  document.getElementById('actModal').style.display = 'flex';
}

function closeActModal() {
  document.getElementById('actModal').style.display = 'none';
}

function saveActivity() {
  var id = document.getElementById('actId').value;
  var text = document.getElementById('actText').value.trim();
  if (!text) return;
  var url = id ? '/admin/activity/edit' : '/admin/activity/add';
  var body = id ? { id: id, text: text } : { text: text };
  fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  }).then(function(r){ return r.json() }).then(function(d){
    if (d.success) { location.reload(); }
    else { alert(d.error || 'Error saving activity'); }
  });
}

function showDeleteActivity(id) {
  actDeleteId = id;
  document.getElementById('actDelModal').style.display = 'flex';
}

function closeActDelModal() {
  document.getElementById('actDelModal').style.display = 'none';
  actDeleteId = null;
}

function confirmDeleteActivity() {
  if (!actDeleteId) return;
  fetch('/admin/activity/delete', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: actDeleteId })
  }).then(function(r){ return r.json() }).then(function(d){
    if (d.success) { location.reload(); }
    else { alert(d.error || 'Error deleting activity'); }
  });
}

setTimeout(function() {
  animateCounter('cnt-users', <%= stats.totalUsers %>);
  animateCounter('cnt-challenges', <%= stats.totalChallenges %>);
  animateCounter('cnt-submissions', <%= stats.totalSubmissions %>);
}, 200);

(function() {
  var ctx = document.getElementById('overviewChart');
  if (!ctx || typeof Chart === 'undefined') return;
  var labels = <%- chartLabels %>;
  new Chart(ctx, {
    type: 'line',
    data: {
      labels: labels,
      datasets: [
        { label: 'New Users', data: <%- chartUsers %>, borderColor: '#FF2D2D', backgroundColor: 'rgba(255,45,45,0.06)', borderWidth: 2, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#FF2D2D', fill: true },
        { label: 'Solves', data: <%- chartSolves %>, borderColor: '#00C2FF', backgroundColor: 'rgba(0,194,255,0.04)', borderWidth: 2, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#00C2FF', fill: true },
        { label: 'Submissions', data: <%- chartSubmissions %>, borderColor: '#FF9500', backgroundColor: 'rgba(255,149,0,0.04)', borderWidth: 2, tension: 0.4, pointRadius: 3, pointBackgroundColor: '#FF9500', fill: true }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false, backgroundColor: '#1C1C1C', borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, titleColor: '#F0F0F0', bodyColor: '#888' } },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false }, ticks: { color: '#555', font: { size: 10 } } },
        y: { grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false }, ticks: { color: '#555', font: { size: 10 }, stepSize: 1 } }
      },
      interaction: { mode: 'index', intersect: false }
    }
  });
})();
</script>
<%- include('../partials/footer') %>

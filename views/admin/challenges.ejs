<%- include('../partials/header') %>
<%- include('../partials/admin-shell') %>

      <div class="page-header">
        <div class="breadcrumb">Admin <span>›</span> Challenges</div>
        <div class="page-title">Challenges</div>
        <div class="page-subtitle">Create and manage CTF-style challenges across all categories. · <a href="/admin/challenges/new" style="color:var(--accent)">Create new</a></div>
      </div>

      <div class="card">
        <div class="card-header">
          <div class="filter-bar" style="padding:0;flex:1">
            <div class="search-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input class="search-input" type="text" placeholder="Search challenges..." id="challengeSearch" />
            </div>
            <div class="filter-btn accent ml-auto" onclick="window.location='/admin/challenges/new'">+ New Challenge</div>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Challenge</th><th>Category</th><th>Difficulty</th><th>Points</th><th>Solves</th><th>Author</th><th>Status</th><th></th></tr></thead>
            <tbody>
              <% if (challenges.length === 0) { %>
              <tr><td colspan="8" style="text-align:center;padding:40px 20px;color:var(--text-muted);font-size:12px">No challenges yet</td></tr>
              <% } else { %>
              <% challenges.forEach(c => { %>
              <tr>
                <td><%= c.title %></td>
                <td class="td-mono"><%= c.category %></td>
                <td><span class="td-badge <%= c.difficulty %>"><%= c.difficulty.charAt(0).toUpperCase() + c.difficulty.slice(1) %></span></td>
                <td class="<%= c.points >= 500 ? 'red-text' : c.points >= 250 ? 'orange-text' : 'green-text' %>"><%= c.points %></td>
                <td class="td-mono"><%= c.solves || 0 %></td>
                <td class="td-mono"><%= c.author || 'admin' %></td>
                <td>
                  <form method="POST" action="/admin/challenges/<%= c.id %>/toggle" style="display:inline">
                    <button type="submit" class="td-badge <%= c.enabled ? 'active' : 'inactive' %>" style="border:none;cursor:pointer;font-family:var(--font-mono)"><%= c.enabled ? 'Published' : 'Draft' %></button>
                  </form>
                </td>
                <td>
                  <div class="td-action">
                    <a href="/challenges/<%= c.id %>" target="_blank" class="filter-btn" style="padding:4px 10px;font-size:10px" title="Preview">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    </a>
                    <a href="/admin/challenges/<%= c.id %>/edit" class="filter-btn" style="padding:4px 10px;font-size:10px">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </a>
                    <form method="POST" action="/admin/challenges/<%= c.id %>/delete" style="display:inline">
                      <button type="submit" onclick="return confirm('Delete this challenge?')" class="filter-btn" style="padding:4px 10px;font-size:10px;border-color:rgba(255,45,45,0.3);color:var(--accent)">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="pagination">
          <span>Showing 1–<%= Math.min(challenges.length, 50) %> of <%= challenges.length %> challenges</span>
          <div class="page-btns">
            <div class="page-btn active">1</div>
          </div>
        </div>
      </div>

<%- include('../partials/footer') %>

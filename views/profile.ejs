<%- include('partials/header') %>
<%- include('partials/user-shell') %>

      <div class="page-header">
        <div class="breadcrumb">Profile</div>
        <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
          <div>
            <div class="page-title"><%= profileUser.displayName || profileUser.username %></div>
            <div class="page-subtitle"><%= profileUser.email %> · Joined <%= new Date(profileUser.createdAt).toLocaleDateString() %></div>
          </div>
          <a href="/profile/edit" class="filter-btn accent" style="padding:8px 16px;font-size:12px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            Edit Profile
          </a>
        </div>
      </div>

      <div style="display:flex;align-items:center;gap:20px;margin-bottom:20px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px">
        <div style="width:72px;height:72px;border-radius:50%;background:var(--accent-dim);border:2px solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:28px;font-weight:700;color:var(--accent);flex-shrink:0;overflow:hidden">
          <% if (profileUser.avatarUrl) { %>
          <img src="<%= profileUser.avatarUrl %>" alt="avatar" style="width:100%;height:100%;object-fit:cover">
          <% } else { %>
          <%= (profileUser.displayName || profileUser.username).charAt(0).toUpperCase() %>
          <% } %>
        </div>
        <div style="flex:1">
          <div style="font-family:var(--font-head);font-size:20px;font-weight:800"><%= profileUser.displayName || profileUser.username %></div>
          <div style="font-size:11px;color:var(--text-muted);margin-top:2px">@<%= profileUser.username %></div>
          <% if (profileUser.bio) { %>
          <div style="font-size:11px;color:var(--text-muted);margin-top:6px;max-width:400px;line-height:1.5"><%= profileUser.bio %></div>
          <% } %>
          <% var links = []; if (profileUser.github) links.push({url:profileUser.github,label:'GitHub',icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>'}); if (profileUser.twitter) links.push({url:profileUser.twitter,label:'X',icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>'});
              if (profileUser.linkedin) links.push({url:profileUser.linkedin,label:'LinkedIn',icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>'});
              if (profileUser.website) links.push({url:profileUser.website,label:'Website',icon:'<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>'});
              if (links.length) { %>
          <div style="display:flex;gap:12px;margin-top:8px;flex-wrap:wrap">
            <% links.forEach(function(l) { %>
            <a href="<%= l.url %>" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--text-muted);text-decoration:none"><%- l.icon %><span><%= l.label %></span></a>
            <% }); %>
          </div>
          <% } %>
        </div>
        <div style="text-align:right">
          <div style="font-family:var(--font-head);font-size:24px;font-weight:800;color:var(--accent)"><%= (profileUser.solvedChallenges || []).length %></div>
          <div style="font-size:10px;color:var(--text-muted)">Solved</div>
          <div style="font-family:var(--font-head);font-size:20px;font-weight:800;color:var(--cyan);margin-top:8px"><%= profileUser.points || 0 %></div>
          <div style="font-size:10px;color:var(--text-muted)">Points</div>
        </div>
      </div>

      <div class="grid-2-eq" style="margin-bottom:20px">
        <div class="card">
          <div class="card-header"><span class="card-title">Solved Challenges</span></div>
          <div style="padding:16px 18px">
            <% if (!solvedChallenges || solvedChallenges.length === 0) { %>
            <div class="empty">No challenges solved yet</div>
            <% } else { %>
            <div style="display:flex;flex-direction:column;gap:6px">
              <% solvedChallenges.forEach(c => { %>
              <a href="/challenges/<%= c.id %>" class="incident-row" style="display:flex;text-decoration:none;padding:8px 0">
                <div class="inc-severity low"></div>
                <div class="inc-info"><div class="inc-name"><%= c.title %></div><div class="inc-target"><%= c.category %> · <%= c.points %> pts</div></div>
                <span class="td-badge <%= c.difficulty %>"><%= c.difficulty.charAt(0).toUpperCase() + c.difficulty.slice(1) %></span>
              </a>
              <% }); %>
            </div>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><span class="card-title">Recent Activity</span></div>
          <div class="timeline">
            <% if (!recentActivity || recentActivity.length === 0) { %>
            <div class="empty">No activity yet</div>
            <% } else { %>
            <% recentActivity.forEach(a => { %>
            <div class="tl-item">
              <div class="tl-dot-wrap"><div class="tl-dot low"></div></div>
              <div class="tl-content">
                <div class="tl-title"><%= a.text %></div>
                <div class="tl-meta"><span class="tl-time"><%= new Date(a.time).toLocaleString() %></span></div>
              </div>
            </div>
            <% }); %>
            <% } %>
          </div>
        </div>
      </div>

<%- include('partials/footer') %>

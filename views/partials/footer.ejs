    </div><!-- end .page.active -->
  </div><!-- end .content -->
</main>
</div><!-- end .app -->
<script src="/js/app.js"></script>
<script>
updateDate();
window.addEventListener('pageshow', function(e) {
  if (e.persisted) {
    fetch('/api/auth-check', { cache: 'no-store' }).then(function(r) { return r.json(); }).then(function(d) {
      if (!d.authenticated) window.location.href = '/login';
    });
  }
});

// ─── Theme Toggle ────────────────────────────────────────────────────────
(function() {
  var curtain = document.getElementById('themeCurtain');
  var btn = document.getElementById('themeToggle');
  var curTheme = localStorage.getItem('ctf-theme') || 'dark';

  function applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : '');
    if (btn) {
      if (t === 'light') {
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
        btn.className = 'theme-btn light';
      } else {
        btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
        btn.className = 'theme-btn dark';
      }
    }
    localStorage.setItem('ctf-theme', t);
    curTheme = t;
  }

  applyTheme(curTheme);

  window.toggleTheme = function() {
    if (!curtain) { applyTheme(curTheme === 'light' ? 'dark' : 'light'); return; }
    var next = curTheme === 'light' ? 'dark' : 'light';
    var nextBg = next === 'light' ? '#f0ece0' : '#080808';
    curtain.style.background = nextBg;
    curtain.className = 'theme-curtain falling';
    setTimeout(function() {
      applyTheme(next);
      curtain.className = 'theme-curtain rising';
      setTimeout(function() { curtain.className = 'theme-curtain'; }, 560);
    }, 500);
  };
})();
</script>
</body>
</html>

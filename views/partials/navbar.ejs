<nav class="fixed top-0 left-0 right-0 z-50 border-b transition-all duration-300 <%= user && user.role === 'admin' ? 'glass-admin border-purple-500/10' : 'glass border-cyan-500/10' %>">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center text-white font-bold text-sm group-hover:scale-110 transition-transform duration-300">
            CTF
          </div>
          <span class="text-lg font-bold text-white hidden sm:block">
            <span class="text-cyan-400">CTF</span>Arena
          </span>
        </a>
      </div>

      <% if (user && user.role === 'admin') { %>
      <!-- ADMIN NAV -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/admin/dashboard" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-purple-400 hover:bg-purple-500/10 transition-all duration-200 <%= currentPage === 'admin-dashboard' ? 'text-purple-400 bg-purple-500/10' : '' %>">
          <i class="fas fa-gauge-high mr-1.5"></i>Overview
        </a>
        <a href="/admin/challenges" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-purple-400 hover:bg-purple-500/10 transition-all duration-200 <%= currentPage === 'admin-challenges' ? 'text-purple-400 bg-purple-500/10' : '' %>">
          <i class="fas fa-flag mr-1.5"></i>Challenges
        </a>
        <a href="/admin/users" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-purple-400 hover:bg-purple-500/10 transition-all duration-200 <%= currentPage === 'admin-users' ? 'text-purple-400 bg-purple-500/10' : '' %>">
          <i class="fas fa-users mr-1.5"></i>Users
        </a>
        <a href="/admin/submissions" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-purple-400 hover:bg-purple-500/10 transition-all duration-200 <%= currentPage === 'admin-subs' ? 'text-purple-400 bg-purple-500/10' : '' %>">
          <i class="fas fa-list mr-1.5"></i>Logs
        </a>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-purple-500/5 border border-purple-500/10">
          <i class="fas fa-shield-halved text-purple-400 text-xs"></i>
          <span class="text-xs font-medium text-purple-400">Admin</span>
        </div>
        <div class="relative group">
          <button class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-purple-500/10 transition-all duration-200">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-purple-400 to-pink-600 flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-purple-500/20">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
            <span class="hidden sm:block text-sm text-gray-300"><%= user.username %></span>
            <i class="fas fa-chevron-down text-xs text-gray-500"></i>
          </button>
          <div class="absolute right-0 mt-2 w-48 rounded-xl glass-admin border border-purple-500/10 shadow-2xl shadow-purple-500/5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0">
            <div class="p-2">
              <a href="/admin/dashboard" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-purple-400 hover:bg-purple-500/10 transition-all">
                <i class="fas fa-gauge-high w-4"></i> Dashboard
              </a>
              <a href="/admin/challenges" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-purple-400 hover:bg-purple-500/10 transition-all">
                <i class="fas fa-flag w-4"></i> Challenges
              </a>
              <hr class="my-1 border-purple-500/10">
              <a href="/" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all">
                <i class="fas fa-eye w-4"></i> View Site
              </a>
              <hr class="my-1 border-purple-500/10">
              <a href="/logout" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-all">
                <i class="fas fa-right-from-bracket w-4"></i> Logout
              </a>
            </div>
          </div>
        </div>
      </div>

      <% } else if (user) { %>
      <!-- USER NAV -->
      <div class="hidden md:flex items-center gap-1">
        <a href="/dashboard" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all duration-200 <%= currentPage === 'dashboard' ? 'text-cyan-400 bg-cyan-500/10' : '' %>">
          <i class="fas fa-home mr-1.5"></i>Dashboard
        </a>
        <a href="/challenges" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all duration-200 <%= currentPage === 'challenges' ? 'text-cyan-400 bg-cyan-500/10' : '' %>">
          <i class="fas fa-flag mr-1.5"></i>Challenges
        </a>
        <a href="/leaderboard" class="px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all duration-200 <%= currentPage === 'leaderboard' ? 'text-cyan-400 bg-cyan-500/10' : '' %>">
          <i class="fas fa-trophy mr-1.5"></i>Leaderboard
        </a>
      </div>

      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-lg bg-yellow-500/5 border border-yellow-500/10 group-hover:bg-yellow-500/10 transition-all">
          <i class="fas fa-star text-yellow-400 text-xs"></i>
          <span class="text-sm font-bold text-yellow-400 font-mono"><%= user.points %></span>
        </div>
        <div class="relative group">
          <button class="flex items-center gap-2 px-3 py-2 rounded-lg hover:bg-cyan-500/10 transition-all duration-200">
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center text-white text-xs font-bold shadow-lg shadow-cyan-500/20">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
            <span class="hidden sm:block text-sm text-gray-300"><%= user.username %></span>
            <i class="fas fa-chevron-down text-xs text-gray-500"></i>
          </button>
          <div class="absolute right-0 mt-2 w-48 rounded-xl glass border border-cyan-500/10 shadow-2xl shadow-cyan-500/5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 translate-y-2 group-hover:translate-y-0">
            <div class="p-2">
              <a href="/profile" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all">
                <i class="fas fa-user w-4"></i> Profile
              </a>
              <a href="/dashboard" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all">
                <i class="fas fa-chart-simple w-4"></i> Dashboard
              </a>
              <hr class="my-1 border-cyan-500/10">
              <a href="/logout" class="flex items-center gap-2 px-3 py-2 rounded-lg text-sm text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-all">
                <i class="fas fa-right-from-bracket w-4"></i> Logout
              </a>
            </div>
          </div>
        </div>
      </div>

      <% } else { %>
      <!-- GUEST NAV -->
      <div class="flex items-center gap-2">
        <a href="/login" class="px-4 py-2 rounded-lg text-sm text-gray-300 hover:text-cyan-400 hover:bg-cyan-500/10 transition-all duration-200">
          Login
        </a>
        <a href="/register" class="px-4 py-2 rounded-lg text-sm bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-medium hover:from-cyan-400 hover:to-blue-500 transition-all duration-200 btn-cyber shadow-lg shadow-cyan-500/20 btn-glow">
          Get Started
        </a>
      </div>
      <% } %>
    </div>
  </div>
</nav>
<div class="h-16"></div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('nav a').forEach(a => {
    a.addEventListener('click', function(e) {
      if (this.href && this.href.startsWith(window.location.origin) && !this.hasAttribute('download')) {
        const loader = document.getElementById('page-loader');
        if (loader) loader.style.display = 'flex';
      }
    });
  });
});
</script>

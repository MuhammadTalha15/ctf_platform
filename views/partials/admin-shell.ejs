<div class="app">
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <div class="logo-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
      </div>
      <div class="logo-text">CTF<span>Arena</span></div>
    </div>
    <div class="logo-sub">Admin Panel</div>
  </div>
  <nav class="nav">
    <div class="nav-section">Admin</div>
    <a href="/admin/dashboard" class="nav-item <%= currentPage === 'admin-dashboard' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Dashboard
    </a>
    <a href="/admin/challenges" class="nav-item <%= currentPage === 'admin-challenges' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 3h12l4 6-10 13L2 9z"/></svg>
      Challenges
    </a>
    <a href="/admin/users" class="nav-item <%= currentPage === 'admin-users' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      Users
    </a>
    <a href="/admin/submissions" class="nav-item <%= currentPage === 'admin-subs' ? 'active' : '' %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
      Submissions
    </a>
    <a href="/logout" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      Logout
    </a>
  </nav>
  <div class="sidebar-user">
    <div class="user-avatar" style="overflow:hidden;position:relative">
      <% if (user.avatarUrl) { %>
      <img src="<%= user.avatarUrl %>" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-radius:50%">
      <% } else { %>
      <%= (user.displayName || user.username).charAt(0).toUpperCase() %>
      <% } %>
    </div>
    <div class="user-info">
      <div class="user-name"><%= user.displayName || user.username %></div>
      <div class="user-role">Administrator</div>
    </div>
    <div class="user-status"></div>
  </div>
</aside>
<main class="main">
  <div class="theme-curtain" id="themeCurtain"></div>
  <div class="topbar">
    <div class="hamburger" id="hamburgerBtn" onclick="document.getElementById('sidebar').classList.toggle('active');document.getElementById('sidebarOverlay').classList.toggle('active')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </div>
    <div class="topbar-date" id="topbarDate"></div>
    <div class="topbar-actions">
      <button class="theme-btn" id="themeToggle" onclick="toggleTheme()" data-tooltip="Toggle theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <a href="/admin/challenges/new" class="topbar-btn" title="New Challenge" data-tooltip="New Challenge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      </a>
    </div>
  </div>
  <div class="content">
    <div class="page active">

<%- include('partials/header') %>
<%- include('partials/user-shell') %>

      <div class="page-header">
        <div class="breadcrumb">Leaderboard</div>
        <div class="page-title">Leaderboard</div>
        <div class="page-subtitle">Top players ranked by total points.</div>
      </div>

      <% if (top3 && top3.length > 0) { %>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px;max-width:600px;margin-left:auto;margin-right:auto">
        <% if (top3[1]) { %>
        <div class="stat-card cyan" style="text-align:center;padding:24px 16px;cursor:pointer" data-user-id="<%= top3[1].id %>">
          <div style="font-size:24px;margin-bottom:8px">🥈</div>
          <div class="stat-value" style="font-size:18px">#2</div>
          <div class="stat-label" style="font-size:13px;margin-top:8px"><%= top3[1].username %></div>
          <div class="stat-sub" style="font-size:11px"><%= top3[1].points || 0 %> pts · <%= (top3[1].solvedChallenges || []).length %> solves</div>
        </div>
        <% } %>
        <% if (top3[0]) { %>
        <div class="stat-card red" style="text-align:center;padding:24px 16px;transform:scale(1.05);z-index:1;cursor:pointer" data-user-id="<%= top3[0].id %>">
          <div style="font-size:28px;margin-bottom:8px">🥇</div>
          <div class="stat-value" style="font-size:20px">#1</div>
          <div class="stat-label" style="font-size:14px;margin-top:8px"><%= top3[0].username %></div>
          <div class="stat-sub" style="font-size:11px"><%= top3[0].points || 0 %> pts · <%= (top3[0].solvedChallenges || []).length %> solves</div>
        </div>
        <% } %>
        <% if (top3[2]) { %>
        <div class="stat-card orange" style="text-align:center;padding:24px 16px;cursor:pointer" data-user-id="<%= top3[2].id %>">
          <div style="font-size:24px;margin-bottom:8px">🥉</div>
          <div class="stat-value" style="font-size:18px">#3</div>
          <div class="stat-label" style="font-size:13px;margin-top:8px"><%= top3[2].username %></div>
          <div class="stat-sub" style="font-size:11px"><%= top3[2].points || 0 %> pts · <%= (top3[2].solvedChallenges || []).length %> solves</div>
        </div>
        <% } %>
      </div>
      <% } %>

      <div class="card">
        <div class="card-header"><span class="card-title">All Players</span></div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>#</th><th>Player</th><th>Points</th><th>Solved</th></tr></thead>
            <tbody>
              <% if (!entries || entries.length === 0) { %>
              <tr><td colspan="4" style="text-align:center;padding:40px 20px;color:var(--text-muted);font-size:12px">No players yet</td></tr>
              <% } else { %>
              <% entries.forEach((e, i) => { %>
              <tr>
                <td class="<%= i < 3 ? 'red-text' : '' %>" style="font-weight:700"><%= i + 1 %></td>
                <td><div class="td-avatar"><div class="mini-av"><%= (e.username || '?').charAt(0).toUpperCase() %></div><a href="#" data-user-id="<%= e.id %>" style="color:var(--text);text-decoration:none"><%= e.username %></a><% if (e.id === user.id) { %><span style="color:var(--text-muted);margin-left:6px;font-size:10px">(you)</span><% } %></div></td>
                <td class="<%= e.points >= 1000 ? 'orange-text' : e.points > 0 ? 'green-text' : '' %>"><%= e.points || 0 %></td>
                <td class="td-mono"><%= (e.solvedChallenges || []).length %></td>
              </tr>
              <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

<%- include('partials/user-popup') %>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<%- include('partials/user-shell') %>

      <div class="page-header">
        <div class="breadcrumb">Profile <span>›</span> Edit</div>
        <div class="page-title">Edit Profile</div>
        <div class="page-subtitle">Update your account information and preferences.</div>
      </div>

      <% if (error) { %>
      <div style="margin-bottom:16px;padding:10px 14px;background:rgba(255,45,45,0.1);border:1px solid rgba(255,45,45,0.2);border-radius:6px;font-size:12px;color:var(--accent)"><%= error %></div>
      <% } %>

      <% if (success) { %>
      <div style="margin-bottom:16px;padding:10px 14px;background:rgba(48,209,88,0.1);border:1px solid rgba(48,209,88,0.2);border-radius:6px;font-size:12px;color:var(--green)"><%= success %></div>
      <% } %>

      <form method="POST" action="/profile/edit" id="profileEditForm">
        <div class="settings-section">
          <div class="settings-title">Avatar</div>
          <div class="settings-row" style="gap:16px">
            <div style="width:64px;height:64px;border-radius:50%;background:var(--accent-dim);border:2px solid var(--accent);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:var(--accent);flex-shrink:0;overflow:hidden">
              <% if (profileUser.avatarUrl) { %>
              <img src="<%= profileUser.avatarUrl %>" alt="avatar" style="width:100%;height:100%;object-fit:cover">
              <% } else { %>
              <%= (profileUser.displayName || profileUser.username).charAt(0).toUpperCase() %>
              <% } %>
            </div>
            <div style="flex:1">
              <div class="settings-label">Avatar URL</div>
              <div class="settings-desc">Enter a URL to an image (Gravatar, GitHub, etc.)</div>
              <input type="url" name="avatarUrl" value="<%= profileUser.avatarUrl || '' %>" class="settings-input" style="width:100%;margin-top:6px" placeholder="https://example.com/avatar.png">
            </div>
          </div>
        </div>

        <div class="settings-section">
          <div class="settings-title">Account Information</div>
          <div class="settings-row">
            <div><div class="settings-label">Display Name</div><div class="settings-desc">The name shown to other players</div></div>
            <input type="text" name="displayName" value="<%= profileUser.displayName || profileUser.username %>" class="settings-input" style="width:250px">
          </div>
          <div class="settings-row">
            <div><div class="settings-label">Username *</div><div class="settings-desc">Your unique login username</div></div>
            <input type="text" name="username" value="<%= profileUser.username %>" required class="settings-input" style="width:250px">
          </div>
          <div class="settings-row">
            <div><div class="settings-label">Email *</div><div class="settings-desc">Your email address</div></div>
            <input type="email" name="email" value="<%= profileUser.email %>" required class="settings-input" style="width:250px">
          </div>
          <div class="settings-row" style="flex-direction:column;align-items:stretch;gap:8px">
            <div><div class="settings-label">Bio</div><div class="settings-desc">Tell other players about yourself</div></div>
            <textarea name="bio" rows="4" style="width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:10px 14px;font-family:var(--font-mono);font-size:12px;color:var(--text);outline:none;resize:vertical" placeholder="Cybersecurity enthusiast, CTF player..."><%= profileUser.bio || '' %></textarea>
          </div>
        </div>

        <div class="settings-section">
          <div class="settings-title">Social Links</div>
          <div class="settings-row">
            <div><div class="settings-label">GitHub</div><div class="settings-desc">Your GitHub profile URL</div></div>
            <input type="url" name="github" value="<%= profileUser.github || '' %>" class="settings-input" style="width:250px" placeholder="https://github.com/username">
          </div>
          <div class="settings-row">
            <div><div class="settings-label">Twitter / X</div><div class="settings-desc">Your Twitter/X profile URL</div></div>
            <input type="url" name="twitter" value="<%= profileUser.twitter || '' %>" class="settings-input" style="width:250px" placeholder="https://twitter.com/username">
          </div>
          <div class="settings-row">
            <div><div class="settings-label">LinkedIn</div><div class="settings-desc">Your LinkedIn profile URL</div></div>
            <input type="url" name="linkedin" value="<%= profileUser.linkedin || '' %>" class="settings-input" style="width:250px" placeholder="https://linkedin.com/in/username">
          </div>
          <div class="settings-row">
            <div><div class="settings-label">Website</div><div class="settings-desc">Your personal website URL</div></div>
            <input type="url" name="website" value="<%= profileUser.website || '' %>" class="settings-input" style="width:250px" placeholder="https://yoursite.com">
          </div>
        </div>

        <div style="display:flex;gap:12px;margin-top:24px">
          <a href="/profile" class="filter-btn" style="padding:10px 20px">Cancel</a>
          <button type="submit" class="filter-btn accent" style="padding:10px 20px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
            Save Changes
          </button>
        </div>
      </form>

      <script>
      (function() {
        var form = document.getElementById('profileEditForm');
        if (!form) return;
        var initial = {};
        var els = form.querySelectorAll('input, textarea');
        for (var i = 0; i < els.length; i++) {
          initial[els[i].name] = els[i].value;
        }
        var isDirty = function() {
          var els = form.querySelectorAll('input, textarea');
          for (var i = 0; i < els.length; i++) {
            if (els[i].value !== initial[els[i].name]) return true;
          }
          return false;
        };
        window.addEventListener('beforeunload', function(e) {
          if (isDirty()) { e.preventDefault(); e.returnValue = ''; }
        });
        var navLinks = document.querySelectorAll('.nav a, a.filter-btn[href]');
        for (var i = 0; i < navLinks.length; i++) {
          (function(link) {
            link.addEventListener('click', function(e) {
              if (isDirty() && !window.confirm('You have unsaved changes. Discard them and leave?')) {
                e.preventDefault();
              }
            });
          })(navLinks[i]);
        }
      })();
      </script>

      <div style="margin-top:32px">
        <form method="POST" action="/profile/change-password">
          <div class="settings-section">
            <div class="settings-title">Change Password</div>
            <div class="settings-row">
              <div><div class="settings-label">Current Password</div><div class="settings-desc">Your existing password</div></div>
              <input type="password" name="currentPassword" required class="settings-input" style="width:250px" placeholder="Enter current password">
            </div>
            <div class="settings-row">
              <div><div class="settings-label">New Password</div><div class="settings-desc">At least 6 characters</div></div>
              <input type="password" name="newPassword" required class="settings-input" style="width:250px" placeholder="Enter new password">
            </div>
            <div class="settings-row">
              <div><div class="settings-label">Confirm Password</div><div class="settings-desc">Re-enter new password</div></div>
              <input type="password" name="confirmPassword" required class="settings-input" style="width:250px" placeholder="Confirm new password">
            </div>
            <div style="margin-top:16px">
              <button type="submit" class="filter-btn accent" style="padding:10px 20px">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Update Password
              </button>
            </div>
          </div>
        </form>
      </div>

<%- include('partials/footer') %>

<%- include('partials/header') %>
<%- include('partials/user-shell') %>

      <div class="page-header">
        <div class="breadcrumb"><a href="/challenges" style="color:var(--text-muted)">Challenges</a> <span style="color:var(--text-dim)">&#8250;</span> <%= challenge.title %></div>
        <div class="page-title"><%= challenge.title %></div>
        <div class="page-subtitle"><%= challenge.category %> &middot; <%= challenge.difficulty.charAt(0).toUpperCase() + challenge.difficulty.slice(1) %> &middot; <%= challenge.points %> pts &middot; by <%= challenge.author || 'admin' %></div>
      </div>

      <div class="challenge-grid">
        <div>
          <div class="card" style="margin-bottom:16px">
            <div class="card-header"><span class="card-title">Description</span></div>
            <div style="padding:16px 18px;font-size:12px;line-height:1.7;color:var(--text);white-space:pre-wrap"><%= challenge.description %></div>
          </div>
          <% if (challenge.flagHint) { %>
          <div class="card" style="margin-bottom:16px">
            <div class="card-header"><span class="card-title">Hint</span></div>
            <div style="padding:16px 18px;font-size:12px;color:var(--text-muted)"><%= challenge.flagHint %></div>
          </div>
          <% } %>
        </div>

        <div>
          <div class="card" style="margin-bottom:16px">
            <div class="card-header"><span class="card-title">Submit Flag</span></div>
            <div style="padding:16px 18px">
              <% if (admin) { %>
              <div style="padding:10px 14px;background:rgba(255,45,45,0.1);border:1px solid rgba(255,45,45,0.2);border-radius:6px;font-size:11px;color:var(--accent)">Admins cannot submit flags. <a href="/admin/challenges" style="text-decoration:underline">Back to admin</a></div>
              <% } else if (solved) { %>
              <div style="text-align:center;padding:20px">
                <div style="font-size:32px;margin-bottom:8px;color:var(--green)">&#10003;</div>
                <div style="font-size:14px;color:var(--green);margin-bottom:4px">Challenge Solved!</div>
                <div style="font-size:11px;color:var(--text-muted)">You earned <%= challenge.points %> points for this challenge.</div>
              </div>
              <% } else { %>
              <form id="flagForm" method="POST" action="/challenges/<%= challenge.id %>/submit">
                <div class="flag-input-group">
                  <input type="text" name="flag" class="flag-input" placeholder="CTF{...}" required autocomplete="off" spellcheck="false" />
                  <button type="submit" class="flag-submit">Submit</button>
                </div>
                <div id="flagResult" style="margin-top:10px"></div>
              </form>
              <% } %>
            </div>
          </div>

          <div class="card">
            <div class="card-header"><span class="card-title">Stats</span></div>
            <div class="card-body" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
              <div style="text-align:center;background:var(--surface2);border-radius:8px;padding:14px">
                <div class="stat-value" style="font-size:22px"><%= challenge.solves || 0 %></div>
                <div class="stat-label">Solves</div>
              </div>
              <div style="text-align:center;background:var(--surface2);border-radius:8px;padding:14px">
                <div class="stat-value" style="font-size:22px;color:var(--accent)"><%= challenge.points %></div>
                <div class="stat-label">Points</div>
              </div>
              <div style="text-align:center;background:var(--surface2);border-radius:8px;padding:14px">
                <div class="stat-value" style="font-size:22px;color:var(--cyan)"><%= challenge.category %></div>
                <div class="stat-label">Category</div>
              </div>
              <div style="text-align:center;background:var(--surface2);border-radius:8px;padding:14px">
                <div class="stat-value" style="font-size:22px"><%= challenge.difficulty.charAt(0).toUpperCase() + challenge.difficulty.slice(1) %></div>
                <div class="stat-label">Difficulty</div>
              </div>
            </div>
          </div>
        </div>
      </div>

<%- include('partials/footer') %>

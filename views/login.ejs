<%- include('partials/header') %>
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px">
<div class="card" style="width:100%;max-width:380px">
  <div style="padding:32px 28px;text-align:center">
    <div class="logo-icon" style="margin:0 auto 16px">
      <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
    </div>
    <div class="page-title" style="font-size:20px;margin-bottom:4px">Welcome Back</div>
    <div class="page-subtitle" style="margin-bottom:24px">Sign in to continue to CTFArena</div>

    <% if (error) { %>
    <div style="margin-bottom:16px;padding:10px 14px;background:rgba(255,45,45,0.1);border:1px solid rgba(255,45,45,0.2);border-radius:6px;font-size:12px;color:var(--accent)"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" style="text-align:left">
      <div style="margin-bottom:16px">
        <label style="display:block;font-size:11px;color:var(--text-muted);margin-bottom:6px">Username</label>
        <input type="text" name="username" required class="settings-input" style="width:100%;min-width:0" placeholder="Enter your username">
      </div>
      <div style="margin-bottom:24px">
        <label style="display:block;font-size:11px;color:var(--text-muted);margin-bottom:6px">Password</label>
        <input type="password" name="password" required class="settings-input" style="width:100%;min-width:0" placeholder="Enter your password">
      </div>
      <button type="submit" class="filter-btn accent" style="width:100%;justify-content:center;padding:10px;font-size:13px">Sign In</button>
    </form>

    <div style="margin-top:20px;font-size:11px;color:var(--text-muted)">
      Don't have an account? <a href="/register" style="color:var(--accent)">Register</a>
    </div>
    <div style="margin-top:8px;font-size:10px;color:var(--text-dim)">
      <a href="/" style="color:var(--text-muted)">← Back to home</a>
    </div>
  </div>
</div>
</div>
<%- include('partials/footer') %>
